# Optional override. Defaults:
# - Development: http://localhost:5000
# - Production: https://ijourney-backend-5elc.onrender.com
# VITE_API_URL=https://ijourney-backend-5elc.onrender.com
VITE_GOOGLE_MAPS_API_KEY=your_http_referrer_restricted_google_maps_key

# Inbox the landing-page contact form opens a message to.
# Defaults to info@i-journey.org — confirm this address before launch.
VITE_CONTACT_EMAIL=info@i-journey.org
